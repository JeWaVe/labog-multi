{
  "rules": {
    "days": {
      "$day": {
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name', 'score', 'level', 'words'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
            "score": { ".validate": "newData.isNumber()" },
            "level": { ".validate": "newData.isNumber()" },
            "words": { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "updated": { ".validate": "true" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
